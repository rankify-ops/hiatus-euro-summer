<div class="wrap">
  <section class="section">
    {%- if section.settings.heading != blank -%}
      <div class="sec-head"><div>{% if section.settings.eyebrow != blank %}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{% endif %}<h2 class="display">{{ section.settings.heading }}{% if section.settings.heading_em != blank %} <em>{{ section.settings.heading_em }}</em>{% endif %}</h2></div></div>
    {%- endif -%}
    <div class="cats">
      {%- for block in section.blocks -%}
        {%- liquid
          assign col = block.settings.collection
          assign label = block.settings.label | default: col.title | default: 'Collection'
          case forloop.index
            when 1
              assign fallback = 'cat-rings.webp'
            when 2
              assign fallback = 'cat-bracelets-2.webp'
            else
              assign fallback = 'cat-necklaces-2.webp'
          endcase
        -%}
        <a class="cat" href="{{ col.url | default: routes.all_products_collection_url }}" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            {{ block.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', alt: label, sizes: '(min-width: 821px) 33vw, 100vw', widths: '600, 900, 1200' }}
          {%- else -%}
            <img src="{{ fallback | asset_url }}" alt="{{ label | escape }}" loading="lazy" width="900" height="1125">
          {%- endif -%}
          <div class="cat-label"><h3>{{ label }}</h3><span>{{ block.settings.cta }} {% render 'icon', name: 'arrow-up' %}</span></div>
        </a>
      {%- endfor -%}
    </div>
  </section>
</div>

{% schema %}
{
  "name": "Category tiles",
  "max_blocks": 3,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Shop by piece" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Made to" },
    { "type": "text", "id": "heading_em", "label": "Heading italic word", "default": "last." }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Tile",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "text", "id": "label", "label": "Label" },
        { "type": "image_picker", "id": "image", "label": "Image (4:5)" },
        { "type": "text", "id": "cta", "label": "Link text", "default": "Shop now" }
      ]
    }
  ],
  "presets": [{
    "name": "Category tiles",
    "blocks": [
      { "type": "tile", "settings": { "label": "Rings" } },
      { "type": "tile", "settings": { "label": "Bracelets" } },
      { "type": "tile", "settings": { "label": "Necklaces" } }
    ]
  }]
}
{% endschema %}

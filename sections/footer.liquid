<footer>
  <div class="wrap">
    <div class="foot glass">
      <div class="foot-brand-col">
        <div class="logo">
          {%- if section.settings.logo != blank -%}
            {{ section.settings.logo | image_url: height: 160 | image_tag: alt: shop.name }}
          {%- else -%}
            <span class="foot-brand"><img src="{{ 'hiatus-flag-h.png' | asset_url }}" alt="" width="67" height="70" loading="lazy" class="foot-h"><span class="foot-name">Hiatus Collection</span></span><span class="visually-hidden">{{ shop.name | escape }}</span>
          {%- endif -%}
        </div>
        {%- if section.settings.blurb != blank -%}<p>{{ section.settings.blurb }}</p>{%- endif -%}
      </div>
      <div class="foot-menus">
        {%- for block in section.blocks -%}
          <div {{ block.shopify_attributes }}>
            <h4>{{ block.settings.heading }}</h4>
            <ul>
              {%- for link in block.settings.menu.links -%}
                <li><a href="{{ link.url }}">{{ link.title }}</a></li>
              {%- endfor -%}
            </ul>
          </div>
        {%- endfor -%}
      </div>
      <div class="foot-signup">
        <h4>Stay in the loop</h4>
        <p>New drops, restocks &amp; exclusive offers.</p>
        <form class="foot-form" action="/contact#contact_form" method="post" accept-charset="UTF-8">
          <input type="hidden" name="form_type" value="customer">
          <input type="hidden" name="utf8" value="✓">
          <input type="hidden" name="contact[tags]" value="newsletter">
          <input type="email" name="contact[email]" placeholder="Your email" required autocomplete="email" class="foot-email">
          <button type="submit" class="foot-sub">Subscribe</button>
        </form>
      </div>
      <div class="legal"><span>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}{% if section.settings.legal != blank %} &middot; {{ section.settings.legal }}{% endif %}</span><span>Prices in {{ cart.currency.iso_code }} &middot; Secure checkout</span></div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "class": "section-footer",
  "max_blocks": 4,
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Logo" },
    { "type": "textarea", "id": "blurb", "label": "About text", "default": "Premium men's jewellery in 925 sterling silver. Made to last." },
    { "type": "text", "id": "legal", "label": "Legal line", "default": "hiatuscollection.com.au" }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menu column",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Shop" },
        { "type": "link_list", "id": "menu", "label": "Menu", "default": "footer" }
      ]
    }
  ],
  "presets": [{ "name": "Footer" }]
}
{% endschema %}

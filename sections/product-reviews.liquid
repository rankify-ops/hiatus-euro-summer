<div class="wrap">
  <section class="pdp-sec rv-wrap" id="reviews">
    <div class="rv-head"><div><span class="eyebrow">Reviews</span><h2 class="display">{{ section.settings.heading }} <em>{{ section.settings.heading_em }}</em></h2></div></div>
    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when '@app' -%}{% render block %}
      {%- endcase -%}
    {%- endfor -%}
  </section>
</div>

{% schema %}
{
  "name": "Reviews",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "In their" },
    { "type": "text", "id": "heading_em", "label": "Heading italic word", "default": "words." },
    { "type": "paragraph", "content": "Add the Judge.me 'Review Widget' app block here." }
  ],
  "blocks": [{ "type": "@app" }],
  "presets": [{ "name": "Reviews" }],
  "enabled_on": { "templates": ["product"] }
}
{% endschema %}

{%- liquid
  capture cat
    render 'product-cat', product: product
  endcapture
-%}
{%- if cat != 'extras' -%}
<div class="wrap">
  <section class="pdp-sec">
    <div class="sec-head"><div><span class="eyebrow">Why the {%- render 'title-fmt', title: product.title -%}</span><h2 class="display">{{ section.settings.heading }} <em>{{ section.settings.heading_em }}</em></h2></div></div>
    <div class="reasons reasons--strip">
      {%- liquid
        assign r1t = section.settings.r1_title
        assign r1b = section.settings.r1_text
        assign r3t = section.settings.r3_title
        assign r3b = section.settings.r3_text
        assign ph = product.handle | append: ' ' | append: product.title | downcase
        assign unearthed = false
        if ph contains 'unearth'
          assign unearthed = true
        endif
        if r1t == blank
          assign r1t = 'Finished like an heirloom'
          if unearthed
            assign r1b = 'The Unearth finish means no two pieces are alike. Yours is the only one like it.'
          else
            assign r1b = 'Premium sterling silver, finished like an heirloom.'
          endif
        endif
        # Card 2: temporary title-only copy (pt546u). Swap in the theme editor under "Card 2".
        if unearthed
          assign r2t = section.settings.r2u_title
          assign r2b = section.settings.r2u_text
        elsif cat == 'necklaces'
          assign r2t = section.settings.r2n_title
          assign r2b = section.settings.r2n_text
        else
          assign r2t = section.settings.r2b_title
          assign r2b = section.settings.r2b_text
        endif
        if r3t == blank
          if cat == 'rings'
            assign r3t = 'Wrong size?'
            assign r3b = 'One exchange within 14 days.'
          else
            assign r3t = 'Made to last'
            assign r3b = 'A lifetime warranty against defects in materials and workmanship, for as long as you own it.'
          endif
        endif
        assign last = product.images.size | minus: 1
      -%}
      {%- assign n = 0 -%}
      {%- for i in (1..3) -%}
        {%- liquid
          case i
            when 1
              assign t = r1t
              assign b = r1b
            when 2
              assign t = r2t
              assign b = r2b
            else
              assign t = r3t
              assign b = r3b
          endcase
          if t == blank
            continue
          endif
          assign n = n | plus: 1
          assign idx = i
          if idx > last
            assign idx = last
          endif
        -%}
        <article class="reason glass">
          <figure>{% if product.images[idx] %}{{ product.images[idx] | image_url: width: 900 | image_tag: loading: 'lazy', alt: '' }}{% endif %}</figure>
          <div><span class="r-num">0{{ n }}</span><h3>{{ t }}</h3>{% if b != blank %}<p>{{ b }}</p>{% endif %}</div>
        </article>
      {%- endfor -%}
    </div>
  </section>
</div>
{%- endif -%}

<style>
/* Why this piece: joined strip (pt546u) */
.reasons--strip{gap:0!important;border:1px solid var(--line,rgba(23,20,15,.13));border-radius:24px;overflow:hidden;background:var(--glass-strong)}
.reasons--strip .reason{border-radius:0!important;border:0!important;border-right:1px solid var(--line,rgba(23,20,15,.13))!important;box-shadow:none!important;backdrop-filter:none!important;-webkit-backdrop-filter:none!important;background:transparent!important}
.reasons--strip .reason:last-child{border-right:0!important}
.reasons--strip .reason h3{font-size:27px}
@media (max-width:820px){.reasons--strip .reason{border-right:0!important;border-bottom:1px solid var(--line,rgba(23,20,15,.13))!important}.reasons--strip .reason:last-child{border-bottom:0!important}}
</style>

{% schema %}
{
  "name": "Why this piece",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "For the moments the world" },
    { "type": "text", "id": "heading_em", "label": "Heading italic word", "default": "stops." },
    { "type": "paragraph", "content": "Reasons fill in automatically for rings, bracelets and necklaces. Fill these in to override card 1 and 3 on every product." },
    { "type": "text", "id": "r1_title", "label": "Reason 1 title" },
    { "type": "textarea", "id": "r1_text", "label": "Reason 1 text" },
    { "type": "header", "content": "Card 2" },
    { "type": "text", "id": "r2u_title", "label": "Unearthed pieces: title", "default": "Silver that wears in, not out." },
    { "type": "textarea", "id": "r2u_text", "label": "Unearthed pieces: text" },
    { "type": "text", "id": "r2b_title", "label": "Other bracelets: title", "default": "Ready for every occasion." },
    { "type": "textarea", "id": "r2b_text", "label": "Other bracelets: text" },
    { "type": "text", "id": "r2n_title", "label": "Necklaces: title", "default": "Earn the pause." },
    { "type": "textarea", "id": "r2n_text", "label": "Necklaces: text" },
    { "type": "text", "id": "r3_title", "label": "Reason 3 title" },
    { "type": "textarea", "id": "r3_text", "label": "Reason 3 text" }
  ],
  "presets": [{ "name": "Why this piece" }],
  "enabled_on": { "templates": ["product"] }
}
{% endschema %}

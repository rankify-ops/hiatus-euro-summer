<div class="wrap">
  <section class="section">
    <div class="join-strip">
      <div><b>{{ section.settings.heading }}</b><span>{{ section.settings.text }}</span></div>
      {%- form 'customer', id: 'joinForm' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        {%- if form.posted_successfully? -%}
          <span class="ok">{{ section.settings.success }}</span>
        {%- else -%}
          <input id="joinEmail" type="email" name="contact[email]" required placeholder="Your email" aria-label="Email address" autocomplete="email">
          <button class="btn btn-primary" type="submit">{{ section.settings.button }}</button>
          {%- if form.errors -%}<span class="err">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</span>{%- endif -%}
        {%- endif -%}
      {%- endform -%}
    </div>
  </section>
</div>

{% schema %}
{
  "name": "Email signup",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "New drops land here first." },
    { "type": "text", "id": "text", "label": "Text", "default": "Join the list to hear about new releases." },
    { "type": "text", "id": "button", "label": "Button", "default": "Join" },
    { "type": "text", "id": "success", "label": "Success message", "default": "You're on the list." }
  ],
  "presets": [{ "name": "Email signup" }]
}
{% endschema %}

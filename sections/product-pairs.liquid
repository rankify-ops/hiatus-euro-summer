{%- liquid
  capture my_cat
    render 'product-cat', product: product
  endcapture
  assign src = section.settings.collection | default: collections.all
  assign shown = 0
-%}
<div class="wrap">
  <section class="section">
    <div class="sec-head"><div><span class="eyebrow">{{ section.settings.eyebrow }}</span><h2 class="display">{{ section.settings.heading }} <em>{{ section.settings.heading_em }}</em></h2></div></div>
    <div class="grid">
      {%- for p in src.products limit: 30 -%}
        {%- if shown >= 4 -%}{%- break -%}{%- endif -%}
        {%- if p.id == product.id -%}{%- continue -%}{%- endif -%}
        {%- capture c %}{% render 'product-cat', product: p %}{% endcapture -%}
        {%- if c == 'extras' -%}{%- continue -%}{%- endif -%}
        {%- if section.settings.other_types and c == my_cat -%}{%- continue -%}{%- endif -%}
        {% render 'product-card', product: p %}
        {%- assign shown = shown | plus: 1 -%}
      {%- endfor -%}
    </div>
  </section>
</div>

{% schema %}
{
  "name": "Wear it with",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Complete the look" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Wear it" },
    { "type": "text", "id": "heading_em", "label": "Heading italic word", "default": "with." },
    { "type": "collection", "id": "collection", "label": "Pick from collection", "info": "Defaults to all products." },
    { "type": "checkbox", "id": "other_types", "label": "Only show other types (e.g. bracelets on a ring page)", "default": true }
  ],
  "presets": [{ "name": "Wear it with" }],
  "enabled_on": { "templates": ["product"] }
}
{% endschema %}

<style>
.liquid-glass{position:relative;isolation:isolate;background:transparent!important;
  backdrop-filter:none!important;-webkit-backdrop-filter:none!important;
  --lg-blur:4px;--lg-tint:.08}
.liquid-glass > .lg-warp{position:absolute;inset:0;z-index:-1;border-radius:inherit;pointer-events:none;
  backdrop-filter:blur(var(--lg-blur)) saturate(150%) brightness(1.04);
  -webkit-backdrop-filter:blur(var(--lg-blur)) saturate(150%) brightness(1.04);
  background:rgba(255,255,255,var(--lg-tint))}
.liquid-glass > .lg-rim{position:absolute;inset:0;z-index:5;border-radius:inherit;pointer-events:none;
  box-shadow:inset 1px 1px 0 rgba(255,255,255,.95),inset -1px -1px 0 rgba(255,255,255,.35),
             inset 0 0 6px rgba(255,255,255,.6),inset 0 0 22px rgba(255,255,255,.18)}
body.scrolled .hdr.liquid-glass{--lg-blur:6px;--lg-tint:.22}
@media(min-width:821px){
  .liquid-glass{background:var(--glass-strong)!important;backdrop-filter:blur(34px) saturate(190%)!important;-webkit-backdrop-filter:blur(34px) saturate(190%)!important;isolation:auto}
  .liquid-glass > .lg-warp,.liquid-glass > .lg-rim{display:none}
}
</style>

<svg id="lg-defs" width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false"><defs></defs></svg>

<script src="{{ 'liquid-glass.js' | asset_url }}" defer></script>
